# Tiger Cloud / TimescaleDB connection string (Tiger Console -> your service -> Connect)
DATABASE_URL=postgres://tsdbadmin:YOUR_PASSWORD@YOUR_HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require

# Free key from https://www.eia.gov/opendata/register.php (only needed for `python ingest.py eia`)
EIA_API_KEY=

# EIA balancing authority code
REGION=PJM
